DATABASE_URL=postgresql://localhost:5432/sweety
# Optional direct Neon connection for migrations; defaults to DATABASE_URL locally.
DATABASE_URL_UNPOOLED=
TEST_DATABASE_URL=postgresql://localhost:5432/sweety_test
SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters
PORT=3001
APP_ORIGIN=http://127.0.0.1:5173
NODE_ENV=development

# Optional Upstash report cache. Leave both blank to disable caching.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
CACHE_NAMESPACE=sweety:development
# Dedicated provider test credentials; never point live tests at production data.
TEST_UPSTASH_REDIS_REST_URL=
TEST_UPSTASH_REDIS_REST_TOKEN=

# BullMQ worker uses Upstash TCP/TLS credentials, not the REST token.
REDIS_URL=
QUEUE_PREFIX=sweety:development:jobs
# Optional remote integration test endpoint; otherwise a temporary native Redis is started.
TEST_REDIS_URL=
# Optional deployed-browser mutation/cleanup target. Omit for read-only smoke checks.
DEPLOYMENT_TEST_DATABASE_URL=
# Optional canonical Origin when checking a staged production deployment URL.
DEPLOYMENT_APP_ORIGIN=
