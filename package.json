{
  "name": "sweety",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:api\" \"npm:dev:client\"",
    "dev:api": "node --env-file=.env --watch server/index.js",
    "dev:client": "vite --host 127.0.0.1",
    "build": "vite build",
    "start": "node --env-file=.env server/index.js",
    "db:migrate": "node --env-file=.env scripts/migrate.js",
    "db:seed": "node --env-file=.env scripts/seed.js",
    "test": "node --env-file=.env --test --test-concurrency=1 tests/*.test.js",
    "test:browser": "node --env-file=.env tests/browser.js && npm run test:session",
    "format": "prettier --write api client server scripts tests vite.config.js vercel.json package.json index.html README.md",
    "format:check": "prettier --check api client server scripts tests vite.config.js vercel.json package.json index.html README.md",
    "test:session": "node tests/session-browser.js",
    "test:deployment": "node tests/deployment-smoke.js"
  },
  "engines": {
    "node": ">=22.12"
  },
  "dependencies": {
    "@vercel/functions": "^3.11.1",
    "bcrypt": "^6.0.0",
    "connect-pg-simple": "^10.0.0",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.3",
    "express-session": "^1.19.0",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.2.1",
    "concurrently": "^10.0.6",
    "playwright": "^1.65.0",
    "prettier": "^3.9.10",
    "supertest": "^7.3.1",
    "vite": "^8.3.6"
  }
}
